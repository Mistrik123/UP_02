<Window x:Class="UP02.ZakaziWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        mc:Ignorable="d"
        Icon="/Images/icon.png"
        Title="ZakaziWindow" Height="520" Width="520" Loaded="Window_Loaded">
    <Grid>
        <Button Name="Back_btn" Content="Назад" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="Back_btn_Click"/>
        <StackPanel Margin="0,50,0,0">
            <Button Name="AddZakaz_btn" Content="Добавить заказ" Padding="10,2" Margin="5,10,0,10" Click="AddZakaz_btn_Click" HorizontalAlignment="Left"/>
            <ListBox Name="ZakaziList" Height="400" SelectionChanged="ZakaziList_SelectionChanged" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
