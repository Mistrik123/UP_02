<Window x:Class="UP02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        Icon="/Images/icon.png"
        mc:Ignorable="d"
        Title="Вход" Height="350" Width="200">
    <Grid>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="/Images/icon.png" Width="100" Height="100" Margin="0,0,0,5"/>
            <Label Content="Вход" FontSize="19" HorizontalAlignment="Center"/>
            <Label Content="Логин" Margin="0,10,0,0"/>
            <TextBox Name="LoginLogTxt" Width="150"/>
            <Label Content="Пароль" Margin="0,10,0,0"/>
            <TextBox Name="PasswordLogTxt" Width="150"/>
            <Button Name="LogBtn" Content="Войти" Margin="0,10,0,0" Click="LogBtn_Click"/>
            <Button Name="RegBtn" Content="Войти как гость" Margin="0,4,0,0" Click="RegBtn_Click"/>
        </StackPanel>

    </Grid>
</Window>
